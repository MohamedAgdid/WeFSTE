@{
    ViewData["Title"] = "About Us";
}

<div class="container my-5">
    <h1 class="text-center mb-4">About WeFSTE</h1>
    <p class="lead text-center">
        Welcome to <strong>WeFSTE</strong> – the official blog of the <span class="text-primary">FSTE IT Club</span>, dedicated to fostering knowledge, creativity, and collaboration in the world of technology.
    </p>

    <div class="row mt-4">
        <div class="col-md-4 text-center">
            <h3><i class="fas fa-users text-info"></i> Community</h3>
            <p>
                We unite students and professionals through workshops, competitions, and meetups to grow together in the tech field.
            </p>
        </div>
        <div class="col-md-4 text-center">
            <h3><i class="fas fa-lightbulb text-warning"></i> Innovation</h3>
            <p>
                Our platform highlights student projects, tech articles, and research that drive innovation and problem-solving.
            </p>
        </div>
        <div class="col-md-4 text-center">
            <h3><i class="fas fa-chalkboard-teacher text-success"></i> Learning</h3>
            <p>
                We share tutorials, guides, and event summaries to promote continuous learning across software, AI, and networks.
            </p>
        </div>
    </div>

    <div class="mt-5 text-center">
        <h3>What is WeFSTE?</h3>
        <p>
            <strong>WeFSTE</strong> is more than a blog – it's a collaborative knowledge hub for students and professors at the
            <strong>Faculty of Sciences and Techniques of Errachidia</strong>. We aim to empower the next generation of developers and tech leaders.
        </p>
    </div>
</div>
