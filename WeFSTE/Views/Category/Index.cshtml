@model IEnumerable<Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-center align-items-center flex-column" style="min-height: 80vh;">
    <h1 class="mb-4">Blog Categories</h1>

    <p>
        <a asp-controller="Category" asp-action="Create" class="btn btn-primary">Create new Category</a>
    </p>

    <div class="table-responsive" style="max-width: 900px; width: 100%;">
        <table class="table table-hover text-center">
            <thead>
                <tr class="table-secondary">
                    <th>Category Name</th>
                    <th>Category Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td>@category.Name</td>
                        <td>@category.Description</td>
                        <td>
                            <a asp-controller="Category" asp-action="Edit" asp-route-id="@category.Id" class="btn btn-warning btn-sm" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-controller="Category" asp-action="Delete" asp-route-id="@category.Id" class="btn btn-danger btn-sm" title="Delete">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
